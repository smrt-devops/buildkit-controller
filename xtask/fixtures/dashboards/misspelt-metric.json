{
  "uid": "fixture-metric",
  "title": "Fixture metric",
  "templating": {"list": [{"name": "datasource", "type": "datasource", "query": "prometheus"}]},
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Panel",
      "description": "Allocation outcomes per second. Check the result label.",
