{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":enableVulnerabilityAlertsWithLabel(security)",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)"
  ],
  "labels": ["dependencies"],
  "minimumReleaseAge": "3 days",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "packageRules": [
    {
      "matchManagers": ["cargo"],
      "groupName": "Rust dependencies",
      "labels": ["dependencies", "rust"],
      "commitMessagePrefix": "chore(deps):",
      "schedule": ["before 10am on monday"],
      "separateMinorPatch": true
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "labels": ["dependencies", "github-actions"],
      "commitMessagePrefix": "chore(ci):",
      "schedule": ["before 10am on monday"]
    },
    {
      "matchManagers": ["dockerfile"],
      "groupName": "Docker base images",
      "labels": ["dependencies", "docker"],
      "commitMessagePrefix": "chore(docker):",
      "schedule": ["before 10am on monday"],
      "pinDigests": true
    },
    {
      "matchManagers": ["helmv3"],
      "groupName": "Helm chart dependencies",
      "labels": ["dependencies", "helm"],
      "commitMessagePrefix": "chore(helm):",
      "schedule": ["before 10am on monday"]
    },
    {
      "matchPackageNames": ["kube", "kube-*", "k8s-openapi"],
      "groupName": "Kubernetes dependencies",
      "labels": ["dependencies", "kubernetes"]
    },
    {
      "matchPackageNames": ["jsonwebtoken", "openidconnect"],
      "groupName": "OIDC dependencies"
    },
    {
      "description": "rust-toolchain.toml, the builder image and rust-version move in one pull request",
      "matchPackageNames": ["rust"],
      "groupName": "Rust toolchain",
      "commitMessagePrefix": "chore(rust):",
      "separateMinorPatch": false
    },
    {
      "matchUpdateTypes": ["major"],
      "labels": ["dependencies", "major-update"],
      "enabled": true
    },
    {
      "matchUpdateTypes": ["minor", "patch"],
      "labels": ["dependencies", "minor-update"]
    },
    {
      "matchDepTypes": ["indirect"],
      "labels": ["dependencies", "indirect"]
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security", "dependencies"],
    "assignees": [],
    "reviewers": []
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "The rust builder image that xtask checks against rust-toolchain.toml",
      "managerFilePatterns": ["/^docker/builder-image$/"],
      "matchStrings": ["(?<depName>rust):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "The workspace rust-version, kept equal to the toolchain",
      "managerFilePatterns": ["/^Cargo\\.toml$/"],
      "matchStrings": ["\\nrust-version = \"(?<currentValue>[0-9.]+)\""],
      "depNameTemplate": "rust",
      "datasourceTemplate": "docker"
    }
  ],
  "ignoreDeps": [],
  "rangeStrategy": "update-lockfile",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 10am on the first day of the month"]
  },
  "schedule": ["before 10am on monday"],
  "timezone": "UTC",
  "rebaseWhen": "conflicted",
  "updateNotScheduled": false,
  "separateMinorPatch": true
}
