{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["edge"],
  "additionalProperties": false,
  "properties": {
    "replicaCount": {"type": "integer", "minimum": 1},
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "global": {"type": "object"},
    "imagePullSecrets": {"type": "array"},
    "autoscaling": {"type": "object"},
    "podDisruptionBudget": {"type": "object"},
    "resources": {"type": "object"},
    "serviceAccount": {"type": "object"},
    "podAnnotations": {"type": "object"},
    "podLabels": {"type": "object"},
    "nodeSelector": {"type": "object"},
    "tolerations": {"type": "array"},
    "affinity": {"type": "object"},
    "topologySpreadConstraints": {"type": "array"},
    "priorityClassName": {"type": "string"},
    "watchNamespaces": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 63}},
    "logLevel": {"type": "string"},
    "logFormat": {"enum": ["json", "text"]},
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "edge": {
      "type": "object",
      "required": ["endpoint", "serverName"],
      "additionalProperties": false,
      "properties": {
        "endpoint": {"type": "string", "pattern": "^tcp://(\\[[0-9A-Fa-f:.]+\\]|[^/:\\[\\]]+):[0-9]+$"},
        "serverName": {"type": "string", "pattern": "^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$"},
        "allocationDomain": {"type": "string"},
        "extraNames": {"type": "array", "items": {"type": "string"}},
        "tls": {"type": "object", "additionalProperties": false, "properties": {"secretName": {"type": "string"}}},
        "handshakeTimeout": {"type": "string", "pattern": "^([0-9]+h)?([0-9]+m)?([0-9]+s)?$", "minLength": 2},
        "maxConnections": {"type": "integer", "minimum": 1},
        "maxHandshakes": {"type": "integer", "minimum": 1},
        "maxHandshakesPerIp": {"type": "integer", "minimum": 0},
        "proxyProtocol": {"$ref": "#/definitions/proxyProtocol"}
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxConnections": {"type": "integer", "minimum": 1},
        "maxConnectionsPerIp": {"type": "integer", "minimum": 0},
        "proxyProtocol": {"$ref": "#/definitions/proxyProtocol"}
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "oidc": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["url", "audiences"],
            "additionalProperties": false,
            "not": {"anyOf": [
              {"required": ["caBundle", "caBundleFile"], "properties": {"caBundle": {"minLength": 1}, "caBundleFile": {"minLength": 1}}},
              {"required": ["caBundle", "caBundleConfigMap"], "properties": {"caBundle": {"minLength": 1}}},
              {"required": ["caBundleFile", "caBundleConfigMap"], "properties": {"caBundleFile": {"minLength": 1}}}
            ]},
            "properties": {
              "url": {"type": "string", "pattern": "^https://"},
              "audiences": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
              "jwksUrl": {"type": "string"},
              "caBundle": {"type": "string"},
              "caBundleFile": {"type": "string"},
              "caBundleConfigMap": {
                "type": "object",
                "required": ["name"],
                "properties": {"name": {"type": "string", "minLength": 1}, "key": {"type": "string"}}
              }
            }
          }
        },
        "serviceAccount": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "audiences": {"type": "array", "items": {"type": "string", "not": {"pattern": "^https://kubernetes\\.default\\.svc"}}},
            "maxConcurrentReviews": {"type": "integer", "minimum": 1},
            "maxReviewsPerIp": {"type": "integer", "minimum": 0},
            "reservedReviews": {"type": "integer", "minimum": 0},
            "recentSubjectTtl": {"type": "string", "pattern": "^([0-9]+h)?([0-9]+m)?([0-9]+s)?$", "minLength": 2}
          }
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {"enum": ["ClusterIP", "NodePort", "LoadBalancer"]},
        "externalTrafficPolicy": {"enum": ["", "Cluster", "Local"]},
        "annotations": {"type": "object"},
        "loadBalancerClass": {"type": "string"},
        "nodePorts": {"type": "object", "additionalProperties": false, "properties": {"api": {"type": ["integer", "null"]}, "edge": {"type": ["integer", "null"]}}},
        "ports": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "api": {"type": "integer", "minimum": 1, "maximum": 65535},
            "edge": {"type": "integer", "minimum": 1, "maximum": 65535}
          }
        }
      }
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "parentRefs": {"$ref": "#/definitions/parentRefs"},
        "annotations": {"type": "object"},
        "labels": {"type": "object"},
        "api": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {"enum": ["terminate", "passthrough"]},
            "parentRefs": {"$ref": "#/definitions/parentRefs"},
            "hostnames": {"type": "array", "items": {"$ref": "#/definitions/gatewayHostname"}},
            "timeouts": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "request": {"$ref": "#/definitions/gatewayDuration"},
                "backendRequest": {"$ref": "#/definitions/gatewayDuration"}
              }
            },
            "backendTLS": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "hostname": {"type": "string"},
                "caCertificateRefs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["name"],
                    "properties": {"group": {"type": "string"}, "kind": {"type": "string"}, "name": {"type": "string", "minLength": 1}}
                  }
                },
                "wellKnownCACertificates": {"enum": ["", "System"]}
              }
            }
          }
        },
        "edge": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "parentRefs": {"$ref": "#/definitions/parentRefs"}
          }
        },
        "envoy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "connectTimeout": {"$ref": "#/definitions/gatewayDuration"},
            "proxyProtocol": {"type": "boolean"},
            "tcpKeepalive": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "idleTime": {"$ref": "#/definitions/gatewayDuration"},
                "interval": {"$ref": "#/definitions/gatewayDuration"},
                "probes": {"type": "integer", "minimum": 1}
              }
            }
          }
        },
        "extraManifests": {"type": "array", "items": {"type": ["object", "string"]}}
      }
    },

    "claims": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "namespaces": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 63}}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"enum": [true, false, "auto"]},
            "interval": {"type": "string"},
            "labels": {"type": "object"}
          }
        }
      }
    },
    "workerNetwork": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deniedCIDRs": {"$ref": "#/definitions/cidrs"},
        "extraDeniedCIDRs": {"$ref": "#/definitions/cidrs"},
        "clusterCIDRs": {"$ref": "#/definitions/cidrs"},
        "dns": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "namespace": {"type": "string"},
            "podLabels": {"type": "object", "additionalProperties": {"type": "string"}},
            "cidrs": {"$ref": "#/definitions/cidrs"}
          }
        },
        "permittedCIDRs": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$", "not": {"pattern": "/0$"}}
        }
      }
    },
    "shutdown": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "delay": {"type": "string", "minLength": 1, "pattern": "^([0-9]+h)?([0-9]+m)?([0-9]+s)?$"},
        "drainTimeout": {"type": "string", "pattern": "^([0-9]+h)?([0-9]+m)?([0-9]+s)?$"}
      }
    },
    "pools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "namespace": {"type": "string"},
          "spec": {"type": "object"}
        }
      }
    },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "maxSize": {"$ref": "#/definitions/size"},
        "poolMaxSize": {"$ref": "#/definitions/size"},
        "maxBlobSize": {"$ref": "#/definitions/size"},
        "maxUploadSize": {"$ref": "#/definitions/size"},
        "gcInterval": {"type": "string", "pattern": "^[1-9][0-9]*[smh]$"},
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "size": {"$ref": "#/definitions/quantity"},
            "storageClass": {"type": "string", "maxLength": 253}
          }
        },
        "resources": {"type": "object"},
        "podAnnotations": {"type": "object"},
        "nodeSelector": {"type": "object"},
        "tolerations": {"type": "array"},
        "affinity": {"type": "object"}
      }
    }
  },
  "definitions": {
    "cidrs": {"type": "array", "items": {"type": "string"}},
    "proxyProtocol": {
      "type": "object",
      "additionalProperties": false,
      "if": {"properties": {"enabled": {"const": true}}, "required": ["enabled"]},
      "then": {"properties": {"trustedCIDRs": {"minItems": 1}}, "required": ["trustedCIDRs"]},
      "properties": {
        "enabled": {"type": "boolean"},
        "trustedCIDRs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9A-Fa-f:.]+/[0-9]{1,3}$"}},
        "headerTimeout": {"type": "string", "pattern": "^([0-9]+h)?([0-9]+m)?([0-9]+s)?$", "minLength": 2}
      }
    },
    "parentRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "group": {"type": "string"},
          "kind": {"type": "string"},
          "name": {"type": "string", "minLength": 1},
          "namespace": {"type": "string"},
          "sectionName": {"type": "string"},
          "port": {"type": "integer", "minimum": 1, "maximum": 65535}
        }
      }
    },
    "gatewayHostname": {"type": "string", "pattern": "^(\\*\\.)?[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$", "maxLength": 253},
    "gatewayDuration": {"type": "string", "pattern": "^([0-9]{1,5}(h|m|s|ms)){1,4}$"},
    "quantity": {"type": ["string", "integer"]},
    "size": {"type": "string", "pattern": "^[0-9]+(Ki|Mi|Gi|Ti)?$"}
  }
}
